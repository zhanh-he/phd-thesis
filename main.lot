\contentsline {table}{\numberline {2.3}{\ignorespaces Approximate relation between critical-band rate in Bark and frequency in Hz. The full psychoacoustic scale spans 24 critical bands.}}{14}{table.caption.28}%
\contentsline {table}{\numberline {2.4}{\ignorespaces Score-dynamics vocabulary, loudness-related scales, and MIDI velocity scales}}{20}{table.caption.29}%
\contentsline {table}{\numberline {2.5}{\ignorespaces Representative AMT results across MAPS, MAESTRO, and MusicNet. The numbers show that velocity-aware transcription remains substantially harder than note transcription.}}{23}{table.caption.32}%
