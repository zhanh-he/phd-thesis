\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Architecture of the proposed multi-task framework. A three-branch multi-scale network encodes either log-Mel or BSSL input at temporal resolutions $T$, $T/s$, and $T/s^{2}$, producing a latent sequence of shape $T\times 8$. An 8-expert MMoE with four gates forms task-specific features, followed by linear heads for the four targets. The scaling factor $s$ is a tunable hyperparameter.}}{72}{figure.caption.69}\protected@file@percent }
\newlabel{fig:audiodyn_model}{{5.2}{72}{Architecture of the proposed multi-task framework. A three-branch multi-scale network encodes either log-Mel or BSSL input at temporal resolutions $T$, $T/s$, and $T/s^{2}$, producing a latent sequence of shape $T\times 8$. An 8-expert MMoE with four gates forms task-specific features, followed by linear heads for the four targets. The scaling factor $s$ is a tunable hyperparameter}{figure.caption.69}{}}
\newlabel{eq:audiodyn_mmoe}{{5.1}{72}{MMoE decoder}{equation.5.1}{}}
