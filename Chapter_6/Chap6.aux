\citation{ryu2024midfild}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Qualitative ablation on a guitar excerpt. From left to right: (a) the reference MIDI notes with ground-truth velocities; (b) the proposed VeloEst + Diff-SFProxy adaptation, whose predicted velocities track the dynamic contour of the reference; (c) the same model trained without the anti-collapse and saturation regularisers ($\mathcal  {L}_{\mathrm  {anti}} + \mathcal  {L}_{\mathrm  {satu}}$), where the predicted velocities collapse towards a near-constant median; (d) Diff-SFProxy adaptation without the MAESTRO-pretrained VeloEst initialisation, trained directly on guitar, where the predicted contour drifts away from the reference. The two failure modes correspond to the bottom two rows of Tables~\ref {tab:bp_results_piano} and~\ref {tab:bp_results_guitar}.}}{101}{figure.caption.96}\protected@file@percent }
\newlabel{fig:bp_ablations}{{6.3}{101}{Qualitative ablation on a guitar excerpt. From left to right: (a) the reference MIDI notes with ground-truth velocities; (b) the proposed VeloEst + Diff-SFProxy adaptation, whose predicted velocities track the dynamic contour of the reference; (c) the same model trained without the anti-collapse and saturation regularisers ($\mathcal {L}_{\mathrm {anti}} + \mathcal {L}_{\mathrm {satu}}$), where the predicted velocities collapse towards a near-constant median; (d) Diff-SFProxy adaptation without the MAESTRO-pretrained VeloEst initialisation, trained directly on guitar, where the predicted contour drifts away from the reference. The two failure modes correspond to the bottom two rows of Tables~\ref {tab:bp_results_piano} and~\ref {tab:bp_results_guitar}}{figure.caption.96}{}}
